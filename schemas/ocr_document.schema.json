{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ocr_document.schema.json",
  "title": "Canonical OCR Document",
  "description": "Canonical, engine-independent representation of a document parsed by PP-StructureV3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source_file",
    "page_count",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "source_mime_type": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ocr_engine": {
      "$ref": "#/$defs/ocr_engine"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "ocr_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ocr_version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "enum": ["cpu", "gpu", "npu", "xpu", "mlu", "other"]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "width",
        "height",
        "orientation",
        "blocks",
        "tables"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Page width in pixels."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Page height in pixels."
        },
        "orientation": {
          "enum": [0, 90, 180, 270],
          "description": "Clockwise page rotation in degrees after preprocessing."
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "type", "bbox", "reading_order"],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^p[1-9][0-9]*_b[0-9]+$"
        },
        "type": {
          "enum": [
            "text",
            "title",
            "header",
            "footer",
            "table",
            "image",
            "seal",
            "formula",
            "chart",
            "unknown"
          ]
        },
        "text": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "polygon": {
          "$ref": "#/$defs/polygon"
        },
        "ocr_confidence": {
          "$ref": "#/$defs/confidence"
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["text", "title", "header", "footer"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["text", "ocr_confidence"]
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "bbox", "cells"],
      "properties": {
        "table_id": {
          "type": "string",
          "pattern": "^p[1-9][0-9]*_t[0-9]+$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "structure_confidence": {
          "$ref": "#/$defs/confidence"
        },
        "html": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table_cell"
          }
        }
      }
    },
    "table_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "column",
        "row_span",
        "column_span",
        "text",
        "bbox",
        "ocr_confidence"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "row_span": {
          "type": "integer",
          "minimum": 1
        },
        "column_span": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "polygon": {
          "$ref": "#/$defs/polygon"
        },
        "ocr_confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source_block_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^p[1-9][0-9]*_b[0-9]+$"
          }
        }
      }
    },
    "bbox": {
      "type": "array",
      "description": "Pixel coordinates in [x_min, y_min, x_max, y_max] order.",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "polygon": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
